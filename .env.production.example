# Copy to .env.production (ignored by Git). Never use development credentials.
COMPOSE_PROJECT_NAME=expotrack-prod
APP_IMAGE=expotrack:production
APP_PORT=3000

# Source checkout for building. Absolute path if Compose lives outside the repo.
SOURCE_DIR=.

# REQUIRED: real JSON catalog, outside Git. No fallback to the demo config/.
# Contains app.json and every file it references (same structure as config/).
CONFIG_DIR=/srv/expotrack/config

# REQUIRED: persistent storage. Create postgres/ and media/ before starting.
DATA_DIR=/srv/expotrack/data

# REQUIRED: two DIFFERENT passwords. Leave empty until configured.
# Generate each with: openssl rand -hex 32
# Quote values with single quotes if they contain $, # or spaces.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Optional: only needed with compose.tunnel.yaml.
TUNNEL_TOKEN=
# Set a reviewed release tag or digest when freezing a deployment.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
