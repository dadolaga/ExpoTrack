{
  "name": "expotrack",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:config": "node scripts/run-config-tools.mjs validate",
    "test:unit": "node scripts/run-config-tools.mjs test",
    "test:integration": "npm run test:local && npm run test:server",
    "validate:final": "node scripts/validate-final.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/run-config-tools.mjs migrate",
    "db:import": "node --env-file-if-exists=.env.local scripts/run-config-tools.mjs import",
    "test:server": "node scripts/run-config-tools.mjs server",
    "test:local": "node scripts/run-config-tools.mjs integration"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "8.72.1"
  }
}
