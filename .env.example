# Solo per Next.js avviato sull'host con PostgreSQL del Compose di sviluppo.
# Copiare in .env.local. Nel devcontainer DATABASE_URL è già impostata da Compose
# con hostname postgres invece di localhost.
# Credenziali di sviluppo: non usare in produzione.
DATABASE_URL=postgresql://expotrack:expotrack_dev@localhost:5432/expotrack
