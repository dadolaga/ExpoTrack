{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "noEmitOnError": true,
    "incremental": false,
    "rootDir": "."
  },
  "include": [
    "src/types/**/*.ts",
    "src/lib/config/**/*.ts",
    "src/lib/offline/**/*.ts",
    "scripts/validate-config.ts",
    "tests/unit/**/*.test.ts",
    "tests/integration/**/*.test.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
