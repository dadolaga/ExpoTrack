{
  "name": "ExpoTrack development",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "runServices": ["app", "postgres"],
  "workspaceFolder": "/workspaces/expotrack",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "ExpoTrack · Next.js",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "sudo chown -R node:node node_modules .next && npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        }
      }
    }
  }
}
